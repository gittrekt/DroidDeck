#!/bin/sh
case "$*" in
  *steamwebhelper*|*vrwebhelper*)
    export LIBGL_KOPPER_DISABLE=false DISABLE_GAMESCOPE_WSI=1 vk_xwayland_wait_ready=true PANVK_KBASE_HEAP_RENEW_INTERVAL=0 PANVK_KBASE_HEAP_RENEW_WORK=0
    ;;
esac
REAL_TASKSET=/usr/bin/taskset
[ -x "$REAL_TASKSET" ] || REAL_TASKSET=/bin/taskset
exec "$REAL_TASKSET" "$@"
