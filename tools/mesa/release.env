# Pinned upstream Mesa source and default packaging settings
MESA_TAG=${MESA_TAG:-android-candidate-beta-1.9.4}
MESA_REPO=${MESA_REPO:-https://github.com/wonderkast02/panvk-g720-kbase-csf.git}
VULKAN_DRIVERS=${VULKAN_DRIVERS:-panfrost}
PANVK_TARGET=${PANVK_TARGET:-csf}
DRIVER_PACKAGE="panvk-${PANVK_TARGET}"
EXTRA_MESON_ARGS=${EXTRA_MESON_ARGS:--Dpanfrost-kmds=panfrost,panthor,kbase}

